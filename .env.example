# Contact form SMTP configuration — required for app/api/contact/route.ts
# Copy this file to .env.local and fill in real values. Never commit .env.local.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" if your provider requires implicit TLS on connect (usually port 465).
# Leave as "false" for STARTTLS on port 587, the common case.
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Optional — defaults shown if unset.
SMTP_FROM="Website Contact Form" <your-smtp-username>
CONTACT_TO_EMAIL=contact@edgesenterprise.com
